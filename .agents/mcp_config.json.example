{
  "mcpServers": {
    "supabase-postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:[YOUR_SUPABASE_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres"
      ],
      "description": "Direct PostgreSQL interface for Console Vault. Keeps database URL out of version control."
    },
    "game-metadata-fetch": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-fetch"
      ],
      "description": "Fetches game cover art and PlayStation 5 game metadata."
    }
  }
}
